<!doctype html>
<html lang="<%= pickLang(lang, 'en', 'zh-Hant') %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= typeof title !== 'undefined' ? title : 'SDCA — San Diego Chinese Academy 聖地牙哥中華學苑' %></title>
  <meta name="description" content="<%= typeof description !== 'undefined' ? description : 'San Diego Chinese Academy 聖地牙哥中華學苑 — non-profit Chinese language school since 1988.' %>">
  <% if (typeof canonical !== 'undefined' && canonical) { %>
  <link rel="canonical" href="<%= canonical %>">
  <% } %>
  <link rel="alternate" hreflang="en" href="<%= typeof enUrl !== 'undefined' ? enUrl : '/en/' %>">
  <link rel="alternate" hreflang="zh-Hant" href="<%= typeof zhUrl !== 'undefined' ? zhUrl : '/zh/' %>">
  <link rel="alternate" hreflang="x-default" href="<%= typeof enUrl !== 'undefined' ? enUrl : '/en/' %>">
  <link rel="icon" href="<%= asset('/favicon/favicon-32.png') %>" type="image/png" sizes="32x32">
  <link rel="icon" href="<%= asset('/favicon/favicon.ico') %>" type="image/x-icon">
  <link rel="apple-touch-icon" sizes="180x180" href="<%= asset('/favicon/apple-touch-icon-180.png') %>">
  <link rel="icon" type="image/png" sizes="192x192" href="<%= asset('/favicon/icon-192.png') %>">
  <link rel="icon" type="image/png" sizes="512x512" href="<%= asset('/favicon/icon-512.png') %>">
  <meta property="og:site_name" content="San Diego Chinese Academy">
  <meta property="og:title" content="<%= typeof title !== 'undefined' ? title : 'SDCA' %>">
  <meta property="og:description" content="<%= typeof description !== 'undefined' ? description : 'Non-profit Chinese language school in San Diego since 1988.' %>">
  <meta property="og:type" content="website">
  <meta property="og:image" content="<%= typeof ogImage !== 'undefined' && ogImage ? ogImage : '/brand/og-image.png' %>">
  <link rel="stylesheet" href="<%= asset('/css/tokens.css') %>">
  <link rel="stylesheet" href="<%= asset('/css/base.css') %>">
  <link rel="stylesheet" href="<%= asset('/css/layout.css') %>">
  <link rel="stylesheet" href="<%= asset('/css/brand.css') %>">
  <link rel="stylesheet" href="<%= asset('/css/components.css') %>">
  <link rel="stylesheet" href="<%= asset('/css/blocks.css') %>">
  <link rel="stylesheet" href="<%= asset('/css/phase5.css') %>">
  <link rel="stylesheet" href="<%= asset('/css/portal.css') %>">
  <link rel="stylesheet" href="<%= asset('/css/portal-app.css') %>">
  <link rel="stylesheet" href="<%= asset('/css/chat.css') %>">
<% if (typeof jsonLd !== 'undefined' && jsonLd) { %>
  <script type="application/ld+json"><%- JSON.stringify(jsonLd) %></script>
<% } %>
</head>
<body>
  <a class="skip-link" href="#main"><%= t('nav.skip') %></a>
  <div id="site">
    <%- typeof header !== 'undefined' ? header : '' %>
    <main id="main" class="site-main" tabindex="-1">
      <%- body %>
    </main>
    <%- typeof footer !== 'undefined' ? footer : '' %>
  </div>
  <script type="module" src="<%= asset('/js/nav.js') %>" defer></script>
  <script type="module" src="<%= asset('/js/tabs.js') %>" defer></script>
  <script type="module" src="<%= asset('/js/lightbox.js') %>" defer></script>
  <script type="module" src="<%= asset('/js/slider.js') %>" defer></script>
  <script type="module" src="<%= asset('/js/mini-calendar.js') %>" defer></script>
  <script type="module" src="<%= asset('/js/forms.js') %>" defer></script>
  <script type="module" src="<%= asset('/js/portal.js') %>" defer></script>
  <script type="module" src="<%= asset('/js/portal-app.js') %>" defer></script>
  <script type="module" src="<%= asset('/js/hero-carousel.js') %>" defer></script>
  <script type="module" src="<%= asset('/js/chat.js') %>" defer></script>
</body>
</html>
