<%# document-edit.ejs %>
<h1><%= item ? 'Edit document' : 'New document' %></h1>
<% if (error) { %><div class="admin-error"><%= error %></div><% } %>
<form method="POST" action="/admin/documents" enctype="multipart/form-data" class="form-grid">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <div class="field"><label>Slug <input type="text" name="slug" value="<%= item ? item.slug : '' %>"></label></div>
  <div class="field"><label>Category <input type="text" name="category" value="<%= item ? item.category : '' %>"></label></div>
  <div class="field"><label>School year <input type="text" name="school_year" value="<%= item ? item.school_year : '' %>"></label></div>
  <div class="field"><label>Sort <input type="number" name="sort" value="<%= item ? item.sort : 0 %>"></label></div>
  <div class="field full"><label>Title (EN) <input type="text" name="title_en" value="<%= item ? item.title_en : '' %>"></label></div>
  <div class="field full"><label>Title (ZH) <input type="text" name="title_zh" value="<%= item ? item.title_zh : '' %>"></label></div>
  <div class="field full">
    <label>File (pdf, jpg, png, docx, xlsx — ≤ 25 MB)
      <input type="file" name="file" accept=".pdf,.jpg,.jpeg,.png,.docx,.xlsx" required>
      <% if (file) { %><small>current: <%= file.name %> (<%= (file.size/1024).toFixed(0) %> KB)</small><% } %>
    </label>
  </div>
  <div class="field"><label>Published <select name="published">
    <option value="1" <%= (item && item.published) || !item ? 'selected' : '' %>>yes</option>
    <option value="0" <%= item && !item.published ? 'selected' : '' %>>no</option>
  </select></label></div>
  <div class="actions">
    <button type="submit" class="btn btn-primary">Save</button>
    <a class="btn" href="/admin/documents">Cancel</a>
  </div>
</form>
