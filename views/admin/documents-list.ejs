<%# documents-list.ejs %>
<div class="list-head">
  <h1>Documents</h1>
  <a class="btn btn-primary" href="/admin/documents/new">+ New document</a>
</div>
<table class="table">
  <thead><tr><th>Title (EN)</th><th>Category</th><th>Year</th><th>Size</th><th>Published</th><th>Actions</th></tr></thead>
  <tbody>
    <% for (const r of rows) { %>
    <tr>
      <td><a href="/admin/documents/<%= r.id %>"><%= r.title_en || r.slug %></a></td>
      <td><%= r.category || '—' %></td>
      <td><%= r.school_year || '—' %></td>
      <td><%= (r.bytes / 1024).toFixed(0) %> KB</td>
      <td><%= r.published ? 'yes' : 'no' %></td>
      <td>
        <a href="/en/documents/<%= r.slug %>">download</a>
        <form method="POST" action="/admin/documents/<%= r.id %>/delete" class="inline-form" onsubmit="return confirm('Delete?')">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button type="submit" class="btn btn-sm btn-danger">Delete</button>
        </form>
      </td>
    </tr>
    <% } %>
  </tbody>
</table>
