<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex, nofollow">
  <title><%= title %> — SDCA Admin</title>
  <link rel="stylesheet" href="/css/tokens.css">
  <link rel="stylesheet" href="/css/base.css">
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body class="admin">
  <header class="admin-top">
    <div class="admin-brand">
      <a href="/en/" class="admin-site">SDCA <span class="sep">/</span> Admin</a>
    </div>
    <nav class="admin-nav" aria-label="Admin sections">
      <a href="/admin/dashboard">Dashboard</a>
      <a href="/admin/announcements">Announcements</a>
      <a href="/admin/events">Events</a>
      <a href="/admin/pages">Pages</a>
      <a href="/admin/programs">Programs</a>
      <a href="/admin/people">People</a>
      <a href="/admin/sponsors">Sponsors</a>
      <a href="/admin/documents">Documents</a>
      <a href="/admin/media">Media</a>
      <a href="/admin/settings">Settings</a>
      <a href="/admin/inbox">Inbox</a>
      <a href="/admin/subscribers">Subs</a>
      <a href="/admin/audit">Audit</a>
    </nav>
    <div class="admin-user">
      <span class="admin-user-name"><%= user && user.username ? user.username : 'guest' %></span>
      <span class="admin-user-role"><%= user && user.role ? user.role : '' %></span>
      <form method="POST" action="/admin/logout" class="inline-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button type="submit" class="btn btn-sm">Log out</button>
      </form>
    </div>
  </header>
  <% if (flash) { %><div class="admin-flash"><%= flash %></div><% } %>
  <% if (error) { %><div class="admin-error"><%= error %></div><% } %>
  <main class="admin-main">
    <%- body %>
  </main>
  <footer class="admin-foot">SDCA Admin — internal use only</footer>
</body>
</html>
