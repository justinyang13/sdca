<%# announcements-list.ejs %>
<div class="list-head">
  <h1>Announcements</h1>
  <a class="btn btn-primary" href="/admin/announcements/new">+ New announcement</a>
</div>
<table class="table">
  <thead><tr><th>Title (EN)</th><th>Kind</th><th>Year</th><th>Week</th><th>Published</th><th>Actions</th></tr></thead>
  <tbody>
    <% for (const r of rows) { %>
    <tr>
      <td><a href="/admin/announcements/<%= r.id %>"><%= r.title_en || r.title_zh || '—' %></a></td>
      <td><span class="chip chip-<%= r.kind %>"><%= r.kind %></span></td>
      <td><%= r.school_year || '—' %></td>
      <td><%= r.week_no ?? '—' %></td>
      <td><%= r.published ? 'yes' : 'no' %></td>
      <td>
        <a href="/en/news/<%= r.slug %>">view</a>
        <form method="POST" action="/admin/announcements/<%= r.id %>/delete" class="inline-form" onsubmit="return confirm('Delete?')">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button type="submit" class="btn btn-sm btn-danger">Delete</button>
        </form>
      </td>
    </tr>
    <% } %>
  </tbody>
</table>
