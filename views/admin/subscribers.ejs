<%# subscribers.ejs %>
<div class="list-head">
  <h1>Newsletter subscribers</h1>
  <a class="btn" href="/admin/subscribers/export.csv">Export CSV</a>
</div>
<% if (rows.length === 0) { %><p class="muted">No subscribers yet.</p><% } %>
<table class="table">
  <thead><tr><th>Email</th><th>Lang</th><th>Confirmed</th><th>Created</th></tr></thead>
  <tbody>
    <% for (const r of rows) { %>
    <tr>
      <td><%= r.email %></td>
      <td><%= r.lang %></td>
      <td><%= r.confirmed ? 'yes' : 'no' %></td>
      <td><%= r.created_at %></td>
    </tr>
    <% } %>
  </tbody>
</table>
