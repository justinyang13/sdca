<%# program-edit.ejs %>
<h1><%= item ? 'Edit program' : 'New program' %></h1>
<form method="POST" action="/admin/programs" class="form-grid">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <div class="field"><label>Slug <input type="text" name="slug" value="<%= item ? item.slug : '' %>"></label></div>
  <div class="field"><label>Sort <input type="number" name="sort" value="<%= item ? item.sort : 0 %>"></label></div>
  <div class="field"><label>Image <input type="text" name="image" value="<%= item ? item.image : '' %>"></label></div>
  <div class="field full"><label>Name (EN) <input type="text" name="name_en" value="<%= item ? item.name_en : '' %>"></label></div>
  <div class="field full"><label>Name (ZH) <input type="text" name="name_zh" value="<%= item ? item.name_zh : '' %>"></label></div>
  <div class="field"><label>Grades (EN) <input type="text" name="grades_en" value="<%= item ? item.grades_en : '' %>"></label></div>
  <div class="field"><label>Grades (ZH) <input type="text" name="grades_zh" value="<%= item ? item.grades_zh : '' %>"></label></div>
  <div class="field full"><label>Description (EN) <textarea name="description_en" rows="6" class="mono"><%= item ? item.description_en : '' %></textarea></label></div>
  <div class="field full"><label>Description (ZH) <textarea name="description_zh" rows="6" class="mono"><%= item ? item.description_zh : '' %></textarea></label></div>
  <div class="field full"><label>Schedule (EN) <textarea name="schedule_en" rows="3" class="mono"><%= item ? item.schedule_en : '' %></textarea></label></div>
  <div class="field full"><label>Schedule (ZH) <textarea name="schedule_zh" rows="3" class="mono"><%= item ? item.schedule_zh : '' %></textarea></label></div>
  <div class="field"><label>Tuition (EN) <input type="text" name="tuition_en" value="<%= item ? item.tuition_en : '' %>"></label></div>
  <div class="field"><label>Tuition (ZH) <input type="text" name="tuition_zh" value="<%= item ? item.tuition_zh : '' %>"></label></div>
  <div class="actions">
    <button type="submit" class="btn btn-primary">Save</button>
    <a class="btn" href="/admin/programs">Cancel</a>
  </div>
</form>
