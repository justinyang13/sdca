<%
  const L = lang;
  const pg = (_pg !== undefined && _pg) || { title_en: 'Support SDCA', title_zh: '支持中華學苑', body_en: '', body_zh: '' };
  const bodyEn = pg.body_en || '';
  const bodyZh = pg.body_zh || '';
  const useZh = (L === 'zh');
  const body = useZh ? (bodyZh || bodyEn) : (bodyEn || bodyZh);
  const noteKey = (useZh)
    ? (bodyZh ? null : (bodyEn ? 'meta.lang_note_zh' : null))
    : (bodyEn ? null : (bodyZh ? 'meta.lang_note_en' : null));
  const title = useZh ? (pg.title_zh || pg.title_en) : (pg.title_en || pg.title_zh);
  const html = (typeof renderMarkdown === 'function') ? renderMarkdown(body) : '';
  const settings = (_settings !== undefined && _settings) || {};
%>

<section class="hero hero--slim">
  <div class="hero-inner">
    <div class="section-kicker"><%= L === 'zh' ? '支持' : 'Support' %></div>
    <h1><%= title %></h1>
    <p class="hero-sub"><%= L === 'zh'
      ? '您的捐款可以報稅，直接支持我們的教學。'
      : 'Your tax-deductible donation directly supports our teaching.' %></p>
  </div>
</section>

<section class="section">
  <div class="container">
    <% if (noteKey) { %><p class="lang-note"><%= t(noteKey) %></p><% } %>
    <div class="prose">
      <%- html %>
    </div>
  </div>
</section>

<section class="section section-alt">
  <div class="container">
    <div class="grid grid-3">
      <div class="icon-tile">
        <span class="icon-badge" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="2.8" y="5.4" width="18.4" height="13.2" rx="2"/><path d="M2.8 9.6h18.4M5.6 5.4v-2"/></svg>
        </span>
        <h3><%= L === 'zh' ? '支票捐款' : 'Donation by Check' %></h3>
        <p><%= L === 'zh'
           ? '請將支票寄至：'
           : 'Please mail your check to: ' %>
           <strong><%= settings.school_name_en || 'San Diego Chinese Academy' %></strong><br>
           <%= settings.mailing_address || 'P.O. Box 910093, San Diego, CA 92191-0093' %>
        </p>
      </div>

      <div class="icon-tile">
        <span class="icon-badge" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M17.8 8V6.2H5.6V17.8h12.2V16"/><path d="M9.2 12h10.6M16.2 8.6 19.8 12l-3.6 3.4"/></svg>
        </span>
        <h3><%= L === 'zh' ? 'PayPal 捐款' : 'Donation via PayPal' %></h3>
        <p><%= L === 'zh'
           ? '透過 PayPal 直接捐款。'
           : 'Donate directly via PayPal.' %>
           <br><a href="https://www.paypal.com/donate/?token=hUlAeNF8LsPGFE8BgSVhTLqBhVqtkq_mg-NcOS-gr3IpHTyXEtoR1Ft9dwG01DgzEcAwMm&country.x=US&locale.x=US" target="_blank" rel="noopener"><%= L === 'zh' ? '點擊捐款' : 'Click to donate' %> →</a>
        </p>
      </div>

      <% if (settings.amazon_smile) { %>
      <div class="icon-tile">
        <span class="icon-badge" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M3.4 14.6c5.4 2.6 11.8 2.6 17.2 0M6 18.2c3.8 1.3 8.2 1.3 12 0"/><circle cx="9.4" cy="8.6" r="1" fill="currentColor" stroke="none"/><circle cx="14.6" cy="8.6" r="1" fill="currentColor" stroke="none"/></svg>
        </span>
        <h3><%= L === 'zh' ? 'AmazonSmile' : 'AmazonSmile' %></h3>
        <p><%= L === 'zh'
           ? '選擇 SDCA 作為您的 AmazonSmile 受贈機構。'
           : 'Choose SDCA as your AmazonSmile designee.' %>
           <br><a href="<%= settings.amazon_smile %>" target="_blank" rel="noopener"><%= L === 'zh' ? '前往 AmazonSmile' : 'Go to AmazonSmile' %> →</a>
        </p>
      </div>
      <% } %>
    </div>
  </div>
</section>

<% if (settings.scrip_refund_1 || settings.scrip_refund_2 || settings.scrip_refund_3) { %>
<section class="section">
  <div class="container">
    <h2 class="section-title"><%= L === 'zh' ? '禮券（Scrip）退款門檻' : 'Scrip Refund Thresholds' %></h2>
    <table class="data-table">
      <thead>
        <tr><th><%= L === 'zh' ? '孩子序號' : 'Child #' %></th><th><%= L === 'zh' ? '退款門檻' : 'Refund Threshold' %></th></tr>
      </thead>
      <tbody>
        <% if (settings.scrip_refund_1) { %><tr><td>1</td><td><%= settings.scrip_refund_1 %></td></tr><% } %>
        <% if (settings.scrip_refund_2) { %><tr><td>2</td><td><%= settings.scrip_refund_2 %></td></tr><% } %>
        <% if (settings.scrip_refund_3) { %><tr><td>3+</td><td><%= settings.scrip_refund_3 %></td></tr><% } %>
      </tbody>
    </table>
    <p class="section-cta"><a class="btn btn-navy" href="/<%= L %>/parents/scrip"><%= L === 'zh' ? '了解更多關於 Scrip' : 'Learn more about Scrip' %> →</a></p>
  </div>
</section>
<% } %>
