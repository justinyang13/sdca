<%
  const L = lang;
  const pg = (_pg !== undefined && _pg) || { title_en: 'Staff', title_zh: '師資團隊', body_en: '', body_zh: '' };
  const staff = (_staff !== undefined && _staff) || [];
  const bodyEn = pg.body_en || '';
  const bodyZh = pg.body_zh || '';
  const useZh = (L === 'zh');
  const body = useZh ? (bodyZh || bodyEn) : (bodyEn || bodyZh);
  const noteKey = (useZh)
    ? (bodyZh ? null : (bodyEn ? 'meta.lang_note_zh' : null))
    : (bodyEn ? null : (bodyZh ? 'meta.lang_note_en' : null));
  const title = useZh ? (pg.title_zh || pg.title_en) : (pg.title_en || pg.title_zh);
  const html = (typeof renderMarkdown === 'function') ? renderMarkdown(body) : '';
  const pickName = (p) => useZh ? (p.name_zh || p.name_en) : (p.name_en || p.name_zh);
  const pickRole = (p) => useZh ? (p.role_zh || p.role_en) : (p.role_en || p.role_zh);
  const pickBio = (p) => useZh ? (p.bio_zh || p.bio_en) : (p.bio_en || p.bio_zh);
%>

<section class="hero hero--slim">
  <div class="hero-inner">
    <div class="section-kicker"><%= L === 'zh' ? '關於我們' : 'About' %></div>
    <h1><%= title %></h1>
    <p class="hero-sub"><%= L === 'zh'
      ? '我們的師資團隊每年參加各種培訓，確保教學技術保持最新。'
      : 'Our staff and teachers work closely with parents and pay attention to each learner\u2019s progress.' %></p>
  </div>
</section>

<section class="section">
  <div class="container container-narrow">
    <% if (noteKey) { %><p class="lang-note"><%= t(noteKey) %></p><% } %>
    <div class="prose">
      <%- html %>
    </div>
  </div>
</section>

<section class="section section-alt">
  <div class="container">
    <h2 class="section-title"><%= L === 'zh' ? '師資與項目負責人' : 'Staff & Program Leads' %></h2>
    <div class="grid grid-3 people-grid">
      <% staff.forEach(function(p) { %>
      <%- renderPart('partials/person-card.ejs', {
        personPhoto: p.photo || '',
        personName: pickName(p),
        personRole: pickRole(p),
        personBio: pickBio(p),
      }) %>
      <% }) %>
    </div>
  </div>
</section>
