<%
  const L = lang;
  const pg = (_pg !== undefined && _pg) || { title_en: 'Enrollment', title_zh: '報名註冊', body_en: '', body_zh: '' };
  const bodyEn = pg.body_en || '';
  const bodyZh = pg.body_zh || '';
  const useZh = (L === 'zh');
  const body = useZh ? (bodyZh || bodyEn) : (bodyEn || bodyZh);
  const noteKey = (useZh)
    ? (bodyZh ? null : (bodyEn ? 'meta.lang_note_zh' : null))
    : (bodyEn ? null : (bodyZh ? 'meta.lang_note_en' : null));
  const title = useZh ? (pg.title_zh || pg.title_en) : (pg.title_en || pg.title_zh);
  const html = (typeof renderMarkdown === 'function') ? renderMarkdown(body) : '';
  const settings = (_settings !== undefined && _settings) || {};
%>

<section class="hero hero--slim">
  <div class="hero-inner">
    <div class="section-kicker"><%= L === 'zh' ? '報名' : 'Enroll' %></div>
    <h1><%= title %></h1>
    <p class="hero-sub"><%= L === 'zh'
      ? '2026-27 學年度註冊說明。'
      : 'How to register for the 2026-27 academic year.' %></p>
    <div class="hero-cta">
      <% if (settings.registration_new) { %>
      <a class="btn btn-primary btn-lg" href="<%= settings.registration_new %>" target="_blank" rel="noopener"><%= L === 'zh' ? '新學生報名' : 'New Student Sign Up' %></a>
      <% } %>
      <% if (settings.registration_returning) { %>
      <a class="btn btn-light btn-lg" href="<%= settings.registration_returning %>" target="_blank" rel="noopener"><%= L === 'zh' ? '回校生登入' : 'Returning Student Sign In' %></a>
      <% } %>
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <% if (noteKey) { %><p class="lang-note"><%= t(noteKey) %></p><% } %>
    <div class="prose">
      <%- html %>
    </div>
  </div>
</section>

<% if (settings.mail_registration) { %>
<section class="section section-alt">
  <div class="container">
    <div class="alert alert-info">
      <strong><%= L === 'zh' ? '注意：' : 'Note: ' %></strong>
      <%= settings.mail_registration %>
    </div>
  </div>
</section>
<% } %>
