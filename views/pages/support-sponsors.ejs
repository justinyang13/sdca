<%
  const L = lang;
  const pg = (_pg !== undefined && _pg) || { title_en: 'Sponsors', title_zh: '贊助商', body_en: '', body_zh: '' };
  const useZh = (L === 'zh');
  const title = useZh ? (pg.title_zh || pg.title_en) : (pg.title_en || pg.title_zh);
  const noteKey = (useZh)
    ? (pg.body_zh ? null : (pg.body_en ? 'meta.lang_note_zh' : null))
    : (pg.body_en ? null : (pg.body_zh ? 'meta.lang_note_en' : null));
  const hasBlocks = (typeof useBlocks !== 'undefined' && useBlocks && typeof blocks !== 'undefined' && blocks.length);
%>
<section class="section">
  <div class="container">
    <% if (noteKey && !hasBlocks) { %><p class="lang-note"><%= t(noteKey) %></p><% } %>
    <% if (hasBlocks && typeof renderPart === 'function') { %>
    <div class="blocks prose">
      <%- renderPart('partials/blocks.ejs', { blocks: blocks }) %>
    </div>
    <% } else { %>
      <%- (typeof renderMarkdown === 'function' && (pg.body_en || pg.body_zh)) ? renderMarkdown(useZh ? (pg.body_zh || pg.body_en) : (pg.body_en || pg.body_zh)) : '' %>
    <% } %>
  </div>
</section>
