<%
  // home.ejs — SDCA home page. All content from DB via ctx.
  const L = lang;
  const settings = (_settings !== undefined && _settings) || {};
  const schoolName = L === 'zh'
    ? (settings.school_name_zh || '聖地牙哥中華學苑')
    : (settings.school_name_en || 'San Diego Chinese Academy');
  const pick = (r, f) => L === 'zh'
    ? (r[`${f}_zh`] || r[`${f}_en`] || '')
    : (r[`${f}_en`] || r[`${f}_zh`] || '');
  const pickNote = (r, f) => {
    const en = r[`${f}_en`] || '';
    const zh = r[`${f}_zh`] || '';
    if (L === 'zh') return zh ? null : (en ? 'meta.lang_note_zh' : null);
    return en ? null : (zh ? 'meta.lang_note_en' : null);
  };
  const dateFmt = (iso) => {
    if (!iso) return '';
    const d = new Date(iso);
    const months = L === 'zh' ? ['1月','2月','3月','4月','5月','6月','7月','8月','9月','10月','11月','12月']
                              : ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
    return `${months[d.getMonth()]} ${d.getDate()}, ${d.getFullYear()}`;
  };
%>

<% const __all = (typeof blocks !== 'undefined' && blocks) ? blocks : []; %>
<% const __introFirst = __all.length && __all[0].columns; %>
<%- renderPart('partials/hero-carousel.ejs', {
  introHtml: __introFirst ? renderPart('partials/blocks.ejs', { blocks: [__all[0]] }).replace(/href="\/en\//g, 'href="/' + L + '/') : '',
  slides: slides,
  schoolName: schoolName,
  tagline: tagline,
  portalUrl: portalUrl,
}) %>

<% const list = __introFirst ? __all.slice(1) : __all; %>
<%
  // Upcoming Event: heading + its list block go left, a small month calendar sits right next to it.
  const __ui = list.findIndex(function(b){ return b.heading && /Upcoming Event/i.test(b.heading.text || ''); });
  const __hasUp = __ui > -1 && list[__ui + 1];
  const __before = __hasUp ? list.slice(0, __ui) : list;
  const __up = __hasUp ? JSON.parse(JSON.stringify(list.slice(__ui, __ui + 2))) : [];
  const __calFiles = [];
  if (__hasUp && __up[1] && __up[1].columns) {
    __up[1].columns.cols = __up[1].columns.cols.map(function(col){
      return col.filter(function(b){ if (b.file) { __calFiles.push(b); return false; } return true; });
    });
  }
  const __after = __hasUp ? list.slice(__ui + 2) : [];
  const __events = [];
  (function walk(x){
    if (Array.isArray(x)) return x.forEach(walk);
    if (x && typeof x === 'object') {
      if (x.list && Array.isArray(x.list.items)) x.list.items.forEach(function(it){
        const m = /^\s*(\d{1,2})\/(\d{1,2})\/(\d{4})\s+(.*)$/s.exec(it);
        if (m) __events.push({ date: m[3] + '-' + m[1].padStart(2, '0') + '-' + m[2].padStart(2, '0'), title: m[4].replace(/\s+/g, ' ').trim() });
      });
      Object.values(x).forEach(walk);
    }
  })(__up);
  const __fix = function(h){ return h.replace(/href="\/en\//g, 'href="/' + L + '/'); };
%>
<section class="section home-blocks" aria-label="<%= L === 'zh' ? '首頁內容' : 'Home page content' %>" data-page="home">
  <div class="container">
    <div class="blocks">
      <%- __fix(renderPart('partials/blocks.ejs', { blocks: __before })) %>
      <% if (__hasUp) { %>
      <div class="home-upcoming">
        <div class="home-upcoming-list blocks">
          <%- __fix(renderPart('partials/blocks.ejs', { blocks: __up })) %>
        </div>
        <div class="home-upcoming-side">
          <aside class="mini-cal" data-mini-cal data-lang="<%= L %>" data-events="<%- JSON.stringify(__events).replace(/&/g,'&amp;').replace(/"/g,'&quot;').replace(/</g,'&lt;') %>" aria-label="<%= L === 'zh' ? '月曆' : 'Monthly calendar' %>"></aside>
          <% if (__calFiles.length) { %>
          <div class="home-upcoming-cal-btn"><%- __fix(renderPart('partials/blocks.ejs', { blocks: __calFiles })) %></div>
          <% } %>
        </div>
      </div>
      <% } %>
      <%- __fix(renderPart('partials/blocks.ejs', { blocks: __after })) %>
    </div>
  </div>
</section>
