<%
  const L = lang;
  const pg = (_pg !== undefined && _pg) || { title_en: 'Adult Chinese — TCML', title_zh: '成人華語文班（TCML）', body_en: '', body_zh: '' };
  const bodyEn = pg.body_en || '';
  const bodyZh = pg.body_zh || '';
  const useZh = (L === 'zh');
  const body = useZh ? (bodyZh || bodyEn) : (bodyEn || bodyZh);
  const noteKey = (useZh)
    ? (bodyZh ? null : (bodyEn ? 'meta.lang_note_zh' : null))
    : (bodyEn ? null : (bodyZh ? 'meta.lang_note_en' : null));
  const title = useZh ? (pg.title_zh || pg.title_en) : (pg.title_en || pg.title_zh);
  const html = (typeof renderMarkdown === 'function') ? renderMarkdown(body) : '';
  const settings = (_settings !== undefined && _settings) || {};
%>

<section class="hero hero--slim">
  <div class="hero-inner">
    <div class="section-kicker"><%= L === 'zh' ? '課程' : 'Programs' %></div>
    <h1><%= title %></h1>
    <p class="hero-sub"><%= L === 'zh'
      ? '適合 18 歲以上的社區中文班。'
      : 'Community-based adult Chinese classes for ages 18+.' %></p>
  </div>
</section>

<section class="section">
  <div class="container container-narrow">
    <% if (noteKey) { %><p class="lang-note"><%= t(noteKey) %></p><% } %>
    <div class="prose">
      <%- html %>
    </div>
  </div>
</section>

<% if (settings.tcml_age || settings.tcml_form) { %>
<section class="section section-alt">
  <div class="container">
    <div class="grid grid-2">
      <% if (settings.tcml_age) { %>
      <div class="icon-tile">
        <span class="icon-badge" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="3.6"/><path d="M4.6 20.4c0-3.8 3.2-6 7.4-6s7.4 2.2 7.4 6"/></svg>
        </span>
        <h3><%= L === 'zh' ? '年齡要求' : 'Age Requirement' %></h3>
        <p><%= settings.tcml_age %></p>
      </div>
      <% } %>
      <% if (settings.tcml_established) { %>
      <div class="icon-tile">
        <span class="icon-badge" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="3.6" y="5" width="16.8" height="15" rx="1.8"/><path d="M3.6 10h16.8M8 2.8v4M16 2.8v4"/></svg>
        </span>
        <h3><%= L === 'zh' ? '成立年份' : 'Established' %></h3>
        <p><%= settings.tcml_established %></p>
      </div>
      <% } %>
    </div>
    <% if (settings.tcml_form) { %>
    <div class="section-cta">
      <a class="btn btn-primary btn-lg" href="<%= settings.tcml_form %>" target="_blank" rel="noopener"><%= L === 'zh' ? '報名 TCML' : 'Register for TCML' %> →</a>
    </div>
    <% } %>
  </div>
</section>
<% } %>
