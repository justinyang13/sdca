<%
  // content-page.ejs — static page body + optional archived-document list.
  // ctx: { pg, mdBody, bodyNote, archivedDocs? }
  const L = lang;
  const pgv = (typeof pg !== 'undefined' && pg) ? pg : { title_en: '', title_zh: '' };
  const title = L === 'zh' ? (pgv.title_zh || pgv.title_en || '') : (pgv.title_en || pgv.title_zh || '');
  const docs = (typeof archivedDocs !== 'undefined' && archivedDocs) ? archivedDocs : [];
%>
<%- renderPart('partials/hero.ejs', {
  heroTitle: title,
  heroVariant: 'slim',
}) %>

<section class="section" aria-labelledby="static-h">
  <div class="container container-narrow">
    <h2 id="static-h" class="sr-only"><%= title %></h2>
    <div class="detail-body markdown">
      <%- mdBody %><% if (!mdBody) { %><p><%= L === 'zh' ? '（內容略）' : '(Content omitted.)' %></p><% } %>
      <% if (bodyNote) { %><p class="lang-note"><%= t(bodyNote) %></p><% } %>
    </div>

    <% if (docs.length) { %>
    <hr>
    <h2 class="section-h2"><%= L === 'zh' ? '檔案文件（直接開啟）' : 'Archived documents (open inline)' %></h2>
    <ul class="doc-list doc-list-compact">
      <% docs.forEach(function(d) { %>
      <li class="doc-item">
        <span class="doc-icon" aria-hidden="true">
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4">
            <path d="M3 1h8l4 4v10H3z"/><path d="M11 1v4h4"/><path d="M6 9h6M6 12h6M6 15h4"/>
          </svg>
        </span>
        <div>
          <h4 class="doc-title">
            <a href="/pdf/<%= d.slug %>" target="_blank" rel="noopener">
              <%= L === 'zh' ? (d.title_zh || d.title_en) : (d.title_en || d.title_zh) %>
            </a>
          </h4>
          <div class="doc-meta">
            <% if (d.school_year) { %><%= d.school_year %> · <% } %>
            <%= Math.max(1, Math.round((d.bytes || 1024) / 1024)) %> KB
          </div>
        </div>
        <a class="btn btn-ghost btn-sm" href="/pdf/<%= d.slug %>/download" download rel="noopener" aria-label="Download">
          <svg width="14" height="14" viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M8 2v8M4 7l4 4 4-4M2 14h12"/></svg>
        </a>
      </li>
      <% }) %>
    </ul>
    <% } %>
  </div>
</section>
