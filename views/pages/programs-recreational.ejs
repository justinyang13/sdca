<%
  const L = lang;
  const pg = (_pg !== undefined && _pg) || { title_en: 'Recreational & Culture Programs', title_zh: '休閒文化課程', body_en: '', body_zh: '' };
  const programs = (_programs !== undefined && _programs) || [];
  const bodyEn = pg.body_en || '';
  const bodyZh = pg.body_zh || '';
  const useZh = (L === 'zh');
  const body = useZh ? (bodyZh || bodyEn) : (bodyEn || bodyZh);
  const noteKey = (useZh)
    ? (bodyZh ? null : (bodyEn ? 'meta.lang_note_zh' : null))
    : (bodyEn ? null : (bodyZh ? 'meta.lang_note_en' : null));
  const title = useZh ? (pg.title_zh || pg.title_en) : (pg.title_en || pg.title_zh);
  const html = (typeof renderMarkdown === 'function') ? renderMarkdown(body) : '';
  const pickName = (p) => useZh ? (p.name_zh || p.name_en) : (p.name_en || p.name_zh);
  const pickDesc = (p) => useZh ? (p.description_zh || p.description_en) : (p.description_en || p.description_zh);
  const recreational = programs.filter(p => p.slug.startsWith('recreational-'));
%>

<section class="hero hero--slim">
  <div class="hero-inner">
    <div class="section-kicker"><%= L === 'zh' ? '課程' : 'Programs' %></div>
    <h1><%= title %></h1>
    <p class="hero-sub"><%= L === 'zh'
      ? '舞蹈、瑜伽、棒球與文化活動。'
      : 'Dance, yoga, baseball and cultural activities for the whole family.' %></p>
  </div>
</section>

<section class="section">
  <div class="container">
    <% if (noteKey) { %><p class="lang-note"><%= t(noteKey) %></p><% } %>
    <div class="prose">
      <%- html %>
    </div>
  </div>
</section>

<% if (recreational.length) { %>
<section class="section section-alt">
  <div class="container">
    <h2 class="section-title"><%= L === 'zh' ? '休閒課程' : 'Recreational Classes' %></h2>
    <div class="grid grid-3">
      <% recreational.forEach(function(p) { %>
      <article class="program-card card">
        <% if (p.image) { %>
        <div class="card-media"><img src="<%= imgUrl(p.image) %>" alt="<%= pickName(p) %>" loading="lazy" width="480" height="320"></div>
        <% } %>
        <div class="card-body">
          <h3 class="card-title"><%= pickName(p) %></h3>
          <% const d = pickDesc(p); if (d) { %><p class="card-desc"><%= d %></p><% } %>
        </div>
      </article>
      <% }) %>
    </div>
  </div>
</section>
<% } %>
