<h1><%= b('Change Password', '更改密碼') %></h1>
<div class="portal-card portal-card-narrow">
  <% if (error) { %><p class="portal-error" role="alert"><%= error %></p><% } %>
  <form method="post" action="<%= url('/change-password') %>" class="pform">
    <%- csrfField() %>
    <%- field({ label: b('Current Password', '目前密碼'), name: 'current', type: 'password', attrs: 'required autocomplete="current-password"' }) %>
    <%- field({ label: b('New Password', '新密碼'), name: 'password', type: 'password', attrs: 'required minlength="8"' }) %>
    <%- field({ label: b('Re-type New Password', '再輸入新密碼'), name: 'password2', type: 'password', attrs: 'required' }) %>
    <div class="fact"><button class="btn btn-primary" type="submit"><%= b('Change Password', '更改密碼') %></button></div>
  </form>
</div>
