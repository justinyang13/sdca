<div class="portal-card portal-card-narrow">
  <h1><%= b('Request Password Reset', '重建密碼') %></h1>
  <% if (!sent) { %>
  <form method="post" action="<%= url('/forgot-password') %>" class="pform">
    <%- csrfField() %>
    <%- field({ label: b('Username', '用戶名稱'), name: 'username', attrs: 'required autofocus' }) %>
    <div class="fact"><button class="btn btn-primary" type="submit"><%= b('Submit', '送出') %></button></div>
  </form>
  <% } else { %>
    <p class="portal-ok"><%= b('If that username exists, a password reset email was sent to the address on file. The link expires in 6 hours.', '如果找到此用戶名稱，已寄出重建密碼的電子郵件。連結六小時內有效。') %></p>
    <% if (link) { %><p class="portal-demo"><strong>Demo mode</strong> — email is not really sent. <a href="<%= link %>"><%= b('Open the reset link', '開啟重建連結') %></a></p><% } %>
  <% } %>
  <p class="portal-links"><a href="<%= url('/signin') %>"><%= b('Back to Sign In', '回到登入') %></a></p>
</div>
