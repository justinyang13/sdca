<%
  const nm = (p) => p ? (p.english_first_name + ' ' + p.english_last_name + (p.chinese_name ? ' ' + p.chinese_name : '')) : '';
%>
<% if (admin) { %>
<section class="dash">
  <h1><%= b('Admin dashboard', '管理員首頁') %><% if (year) { %> <small>· <%= year.label %></small><% } %></h1>
  <div class="stat-grid">
    <a class="stat" href="<%= url('/manage/families') %>"><strong><%= admin.families %></strong><span><%= b('Families', '家庭') %></span></a>
    <a class="stat" href="<%= url('/manage/persons') %>"><strong><%= admin.persons %></strong><span><%= b('People', '人員') %></span></a>
    <a class="stat" href="<%= url('/manage/enrollments') %>"><strong><%= admin.students %></strong><span><%= b('Students this year', '本學年學生') %></span></a>
    <a class="stat" href="<%= url('/manage/school_classes') %>"><strong><%= admin.classes %></strong><span><%= b('Classes', '班級') %></span></a>
    <a class="stat" href="<%= url('/manage/users') %>"><strong><%= admin.users %></strong><span><%= b('Users', '用戶') %></span></a>
    <a class="stat" href="<%= url('/manage/email_outbox') %>"><strong><%= admin.outbox %></strong><span><%= b('Emails (demo outbox)', '郵件 (示範寄件匣)') %></span></a>
  </div>
  <div class="grid-2">
    <div class="portal-card"><h2><%= b('Registrations', '註冊') %></h2>
      <ul class="plain"><% admin.regs.forEach(function(r){ %><li><a href="<%= url('/manage/registrations') %>?f_status=<%= r.status %>&yr=1"><%= r.status %></a>: <strong><%= r.n %></strong></li><% }) %><% if (!admin.regs.length) { %><li class="muted">—</li><% } %></ul></div>
    <div class="portal-card"><h2><%= b('Set up the school', '學校設定') %></h2>
      <p class="btn-row"><a class="btn btn-ghost" href="<%= url('/fees') %>"><%= b('Fees for a School Year', '學年費用設定') %></a>
         <a class="btn btn-ghost" href="<%= url('/manage/roles') %>"><%= b('Roles & Permissions', '角色與權限') %></a>
         <a class="btn btn-ghost" href="<%= url('/manage/school_years') %>"><%= b('School Years', '學年') %></a>
         <a class="btn btn-ghost" href="<%= url('/manage/school_classes') %>"><%= b('Classes', '班級') %></a></p></div>
  </div>
  <div class="portal-card"><h2><%= b('Recent activity', '最近活動') %></h2>
    <table class="portal-table compact"><tbody><% admin.recent.forEach(function(a){ %><tr><td><%= fmtDateTime(a.at) %></td><td><%= a.username || '—' %></td><td><%= a.action %></td><td><%= a.table_name %> #<%= a.row_id %></td></tr><% }) %></tbody></table>
    <p><a href="<%= url('/manage/portal_audit') %>"><%= b('Full audit log', '完整稽核紀錄') %> ›</a></p></div>
</section>
<% } %>

<% if (secretary) { %>
<section class="dash">
  <h1><%= b('Secretary Resources', '秘書專區') %><% if (!admin && year) { %> <small>· <%= year.label %></small><% } %></h1>
  <% if (secretary.tools) { %>
  <p class="btn-row">
    <% if (can('persons.list')) { %><a class="btn btn-ghost" href="<%= url('/manage/persons') %>"><%= b('List All People', '人員名單') %></a><% } %>
    <% if (can('reports.class_roster')) { %><a class="btn btn-ghost" href="<%= url('/class-roster') %>"><%= b('Class Roster', '班級人數清單') %></a><% } %>
    <% if (can('volunteer_list.list')) { %><a class="btn btn-ghost" href="<%= url('/manage/volunteer_list') %>"><%= b('Volunteer List', '義工名單') %></a><% } %>
    <% if (can('student_list.list')) { %><a class="btn btn-ghost" href="<%= url('/manage/student_list') %>"><%= b('Student List', '學生名單') %></a><% } %>
    <% if (can('placement.assign')) { %><a class="btn btn-ghost" href="<%= url('/placement') %>"><%= b('Class Placement', '分班') %> (<%= secretary.unplaced %>)</a><% } %>
  </p><% } %>
  <div class="portal-card"><h2><%= b('Registrations waiting for payment', '等待付款的註冊') %></h2>
    <% if (!secretary.pendingPay.length) { %><p class="muted"><%= b('None.', '沒有。') %></p><% } else { %>
    <table class="portal-table compact"><thead><tr><th>#</th><th><%= b('Parent', '家長') %></th><th><%= b('Submitted', '送出') %></th><th class="num"><%= b('Total', '總計') %></th><th></th></tr></thead><tbody>
      <% secretary.pendingPay.forEach(function(r){ %><tr><td><a href="<%= url('/registrations/' + r.id) %>"><%= r.id %></a></td><td><%= r.parent %></td><td><%= fmtDateTime(r.submitted_at) %></td><td class="num"><%= money(r.grand_total_cents) %></td>
        <td><% if (can('finance.record_payment')) { %><a href="<%= url('/finance/payment?registration=' + r.id) %>"><%= b('Enter Payment', '輸入付款') %></a><% } %></td></tr><% }) %>
    </tbody></table><% } %></div>
</section>
<% } %>

<% if (finance) { %>
<section class="dash">
  <h1><%= b('Finance', '財務') %><% if (year) { %> <small>· <%= year.label %></small><% } %></h1>
  <p class="btn-row"><a class="btn btn-primary" href="<%= url('/finance/payment') %>"><%= b('Enter Payment', '輸入付款') %></a>
    <a class="btn btn-ghost" href="<%= url('/finance/manual/new') %>"><%= b('New Manual Transaction', '新增手動交易') %></a>
    <a class="btn btn-ghost" href="<%= url('/fees') %>"><%= b('Fees for a School Year', '學年費用設定') %></a>
    <a class="btn btn-ghost" href="<%= url('/manage/transactions') %>"><%= b('All Transactions', '所有交易') %></a></p>
  <div class="grid-2">
    <div class="portal-card"><h2><%= b('Awaiting payment', '待付款') %></h2>
      <% if (!finance.pendingPay.length) { %><p class="muted">—</p><% } else { %><table class="portal-table compact"><tbody>
        <% finance.pendingPay.forEach(function(r){ %><tr><td><a href="<%= url('/registrations/' + r.id) %>">#<%= r.id %></a></td><td><%= r.parent %></td><td class="num"><%= money(r.grand_total_cents) %></td><td><a href="<%= url('/finance/payment?registration=' + r.id) %>"><%= b('Enter Payment', '輸入付款') %></a></td></tr><% }) %></tbody></table><% } %></div>
    <div class="portal-card"><h2><%= b('This year totals', '本學年合計') %></h2>
      <table class="portal-table compact"><tbody><% finance.totals.forEach(function(t){ %><tr><td><%= t.type %></td><td><%= t.n %></td><td class="num"><%= money(t.total) %></td></tr><% }) %></tbody></table></div>
  </div>
  <div class="portal-card"><h2><%= b('Recent transactions', '最近交易') %></h2><table class="portal-table compact"><tbody>
    <% finance.recent.forEach(function(t){ %><tr><td><a href="<%= url('/transactions/' + t.id) %>"><%= fmtDate(t.transaction_date) %></a></td><td><%= t.type %></td><td><%= t.method %></td><td class="num"><%= t.voided_at ? '(void)' : '' %> <%= money(t.amount_cents) %></td></tr><% }) %></tbody></table></div>
</section>
<% } %>

<% if (pta) { %>
<section class="dash">
  <h1><%= b('Volunteers', '義工') %></h1>
  <p class="btn-row"><a class="btn btn-ghost" href="<%= url('/manage/volunteer_signups') %>"><%= b('Volunteer Sign-ups', '義工報名') %></a>
    <a class="btn btn-ghost" href="<%= url('/manage/volunteer_jobs') %>"><%= b('Volunteer Jobs', '義工工作') %></a>
    <% if (can('volunteer_list.list')) { %><a class="btn btn-ghost" href="<%= url('/manage/volunteer_list') %>"><%= b('Volunteer List', '義工名單') %></a><% } %>
</p>
  <div class="portal-card"><h2><%= b('Sign-ups by job', '各項工作報名') %></h2><table class="portal-table compact"><tbody>
    <% pta.byJob.forEach(function(j){ %><tr><td><%= one(j.en, j.zh) %></td><td class="num"><%= j.n %></td></tr><% }) %></tbody></table>
    <p><%= b('Waiting to be assigned', '待分派') %>: <strong><%= pta.unassigned %></strong> · <%= b('Cannot volunteer', '無法服務') %>: <%= pta.declined %></p></div>
</section>
<% } %>

<% if (instructor) { %>
<section class="dash">
  <h1><%= b('Instructor Resources', '教師專區') %></h1>
  <% if (!instructor.length) { %><p class="muted"><%= b('You have no class assignments this year.', '本學年沒有任課或班級家長指派。') %></p><% } %>
  <div class="card-grid"><% instructor.forEach(function(c){ %>
    <a class="portal-card class-card" href="<%= url('/classes/' + c.id) %>"><strong><%= one(c.name_en, c.name_zh) %></strong>
      <small><%= b('Room', '教室') %>: <%= c.room || '—' %> · <%= c.students %> <%= b('students', '位學生') %> · <%= one(c.role_en, c.role_zh) %></small>
      <span class="btn btn-ghost"><%= b('Student list', '學生名單') %></span></a><% }) %></div>
</section>
<% } %>

<% if (typeof families !== 'undefined' && families && families.length) { %>
<section class="dash"><h1><%= b('Parent Resources', '家長專區') %><% if (year) { %> <small>· <%= year.label %></small><% } %></h1></section>
  <% families.forEach(function(F){ %><%- include('_family', { F: F, staffView: false, canRegister: canRegister, me: U.person }) %><% }) %>
<% } %>

<% if (volunteer) { %>
<section class="dash"><h2><%= b('My volunteer sign-up', '我的義工報名') %></h2>
  <% if (!volunteer.length) { %><p class="muted"><%= b('No volunteer sign-up yet.', '尚未報名。') %></p><% } %>
  <ul class="plain"><% volunteer.forEach(function(v){ %><li><strong><%= v.priority %></strong> · <%= v.name_en ? one(v.name_en, v.name_zh) : '—' %> <span class="pill"><%= v.status %></span> <% if (v.aname) { %>→ <%= one(v.aname, v.aname_zh) %><% } %></li><% }) %></ul>
  <p><a class="btn btn-ghost" href="<%= url('/volunteer') %>"><%= b('Volunteer Sign Up', '義工報名') %></a></p></section>
<% } %>

<% if (student) { %>
<section class="dash">
  <h1><%= b('My School', '我的學校') %></h1>
  <div class="portal-card"><h2><%= nm(student.person) %></h2>
    <% if (student.enrollment) { const e = student.enrollment; %>
      <dl class="kv">
        <dt><%= b('School year', '學年') %></dt><dd><%= e.year_label %></dd>
        <dt><%= b('Class type', '班別') %></dt><dd><%= one(e.ct_en, e.ct_zh) %></dd>
        <dt><%= b('SDCA Grade', 'SDCA 年級') %></dt><dd><%= gl(e.grade_label) %></dd>
        <% if (student.showPlacement && e.code) { %>
        <dt><%= b('Class', '班級') %></dt><dd><%= one(e.name_en, e.name_zh) %></dd>
        <dt><%= b('Room', '教室') %></dt><dd><%= e.room || '—' %></dd>
        <dt><%= b('Teacher', '老師') %></dt><dd><% student.teachers.forEach(function(t, i){ %><%= i ? ', ' : '' %><%= nm(t) %> (<%= one(t.role_en, t.role_zh) %>)<% }) %><% if (!student.teachers.length) { %>—<% } %></dd>
        <% } else { %><dt><%= b('Class', '班級') %></dt><dd class="muted"><%= b('Your class will be shown one week before school starts.', '開學前一週會顯示班級資料。') %></dd><% } %>
      </dl>
    <% } else { %><p class="muted"><%= b('You are not registered for this school year yet.', '本學年尚未註冊。') %></p><% } %></div>
  <% if (student.school) { const s = student.school; %>
  <div class="portal-card"><h2><%= b('My middle / high school', '我的國中/高中') %></h2>
    <dl class="kv"><dt><%= b('School Name', '學校名稱') %></dt><dd><%= s.school_name %> (<%= b('Grade', '年級') %> <%= s.grade %>)</dd>
      <dt><%= b('Address', '地址') %></dt><dd><%= s.mailing_address %>, <%= s.city %>, <%= s.state %> <%= s.zipcode %></dd>
      <dt><%= b('Counselor', '輔導老師') %></dt><dd><%= s.counselor_name %> <%= s.counselor_phone %> <%= s.counselor_extension ? 'x' + s.counselor_extension : '' %></dd>
      <dt><%= b('School District', '學區') %></dt><dd><%= s.district || s.other_school_district %></dd></dl></div><% } %>
  <div class="portal-card"><h2><%= b('My credit grades', '我的學分成績') %></h2>
    <% if (!student.grades.length) { %><p class="muted"><%= b('No grades have been published yet.', '尚未公布成績。') %></p><% } else { %>
    <table class="portal-table compact"><thead><tr><th><%= b('Year', '學年') %></th><th><%= b('Term', '學期') %></th><th><%= b('Course', '課程') %></th><th><%= b('Grade', '等第') %></th><th>%</th><th><%= b('Credits', '學分') %></th><th><%= b('Comment', '評語') %></th></tr></thead><tbody>
      <% student.grades.forEach(function(g){ %><tr><td><%= g.year_label %></td><td><%= g.term %></td><td><%= g.course_name %></td><td><strong><%= g.letter_grade %></strong></td><td><%= g.percent ?? '' %></td><td><%= g.credits %></td><td><%= g.teacher_comment %></td></tr><% }) %></tbody></table>
    <p class="muted"><%= b('Total credits earned', '累計學分') %>: <strong><%= student.grades.reduce(function(s, g){ return s + (g.letter_grade && g.letter_grade !== 'F' ? Number(g.credits || 0) : 0); }, 0) %></strong></p><% } %></div>
</section>
<% } %>
<% if (!admin && !secretary && !finance && !pta && !instructor && !(typeof families !== 'undefined' && families) && !volunteer && !student) { %>
  <p class="muted"><%= b('Your account has no pages yet. Please contact the school office.', '您的帳戶尚無可用頁面，請聯絡學校辦公室。') %></p>
<% } %>
