<%# Portal shell: the menus live in the portal header (portal-header.ejs). locals: inner, flash %>
<section class="section portal-app-section" data-portal>
  <div class="container portal-app">
    <div class="portal-main">
      <% if (flash) { %><div class="portal-flash portal-flash-<%= flash.type || 'ok' %>" role="status"><%= flash.msg %></div><% } %>
      <%- inner %>
    </div>
  </div>
</section>
<div data-session-timeout="<%= idleMinutes %>" data-ping="<%= url('/ping') %>" data-lang="<%= lang %>" hidden></div>
<script src="<%= asset('/js/session-timeout.js') %>" defer></script>
