<%
  const nmP = (p) => p ? (p.english_first_name + ' ' + p.english_last_name + (p.chinese_name ? ' ' + p.chinese_name : '')) : '';
%>
<div class="portal-head"><h1><%= nmP(person) %></h1>
  <div class="portal-actions"><a class="btn btn-ghost" href="<%= url('/manage/persons') %>">‹ <%= b('Directory', '通訊錄') %></a>
    <% if (canUpdate) { %><a class="btn btn-ghost" href="<%= url('/manage/persons/' + person.id) %>"><%= b('Staff edit (all fields)', '員工編輯') %></a><% } %></div></div>
<div class="portal-card"><h2><%= b('Person', '個人資料') %></h2>
  <dl class="kv">
    <dt><%= b('Chinese Name', '中文姓名') %></dt><dd><%= person.chinese_name || '—' %></dd>
    <dt><%= b('English Name', '英文姓名') %></dt><dd><%= person.english_first_name %> <%= person.english_last_name %></dd>
    <dt><%= b('Gender', '性別') %></dt><dd><%= person.gender %></dd>
    <dt><%= b('Birth Date', '出生日期') %></dt><dd><%= fmtDate(person.birth_date) || '—' %></dd>
    <dt><%= b('Native Language', '母語') %></dt><dd><%= person.native_language %></dd>
    <dt><%= b('Email / Mobile', '電子郵件 / 手機') %></dt><dd><%= person.email || '—' %> / <%= person.mobile || '—' %></dd>
    <% if (person.allergy || person.special_medical_needs) { %><dt><%= b('Allergy / Medical', '過敏 / 醫護') %></dt><dd><%= person.allergy %> / <%= person.special_medical_needs %></dd><% } %>
    <% if (person.p_street) { %><dt><%= b('Personal address', '個人住址') %></dt><dd><%= person.p_street %>, <%= person.p_city %>, <%= person.p_state %> <%= person.p_zip %></dd><% } %>
    <% if (user) { %><dt><%= b('User Name', '用戶名稱') %></dt><dd><a href="<%= url('/manage/users/' + user.id) %>"><%= user.username %></a> <span class="pill"><%= user.status %></span></dd><% } %>
  </dl>
  <p class="btn-row"><% if (canUpdate) { %><a class="btn btn-ghost" href="<%= url('/people/' + person.id + '/edit') %>"><%= b('Edit Person Details', '編輯個人資料') %></a>
    <a class="btn btn-ghost" href="<%= url('/manage/persons/' + person.id) %>#f_p_street"><%= b('Create Personal Address', '建立個人住址') %></a><% } %></p></div>
<% if (F) { %><%- include('_family', { F: F, staffView: true, canRegister: false, me: null }) %><% } %>
<div class="portal-card"><h2><%= b('Grade And Class Assignments', '年級與班級') %></h2>
  <% if (!enrollments.length) { %><p class="muted">—</p><% } else { %><table class="portal-table compact"><thead><tr><th><%= b('Year', '學年') %></th><th><%= b('Class Type', '班別') %></th><th><%= b('SDCA Grade', '年級') %></th><th><%= b('Class', '班級') %></th><th><%= b('Status', '狀態') %></th></tr></thead><tbody>
    <% enrollments.forEach(function(e){ %><tr><td><%= e.year %></td><td><%= one(e.ct_en || '', e.ct_zh || '') %></td><td><%= gl(e.grade_label) %></td><td><%= e.code ? e.code + ' ' + one(e.name_en, e.name_zh) : '—' %></td><td><span class="pill"><%= e.status %></span></td></tr><% }) %></tbody></table><% } %></div>
<div class="portal-card"><h2><%= b('Transaction History', '付款紀錄') %></h2>
  <% if (!tx.length) { %><p class="muted"><%= b('No Transaction History', '沒有付款紀錄') %></p><% } else { %><table class="portal-table compact"><tbody><% tx.forEach(function(t){ %><tr><td><a href="<%= url('/transactions/' + t.id) %>"><%= fmtDate(t.transaction_date) %></a></td><td><%= t.type %></td><td class="num"><%= money(t.amount_cents) %></td></tr><% }) %></tbody></table><% } %>
  <% if (canPay && year) { %><h3><%= b('Transaction Process', '交易') %></h3><p class="btn-row">
    <a class="btn btn-ghost" href="<%= url('/finance/payment?family=' + (fid || '') + '&person=' + person.id) %>"><%= b('Enter Registration Payment For ' + year.label + ' School Year', '輸入 ' + year.label + ' 註冊付款') %></a>
    <a class="btn btn-ghost" href="<%= url('/finance/manual/new?family=' + (fid || '') + '&person=' + person.id) %>"><%= b('Enter Manual Transaction For ' + year.label + ' School Year', '輸入 ' + year.label + ' 手動交易') %></a></p><% } %></div>
<div class="portal-card"><h2><%= b('Instructor Assignments', '任課指派') %></h2>
  <% if (assignments.length) { %><table class="portal-table compact"><thead><tr><th><%= b('Year', '學年') %></th><th><%= b('Class', '班級') %></th><th><%= b('Role', '角色') %></th><th><%= b('Start', '開始') %></th><th><%= b('End', '結束') %></th><th></th></tr></thead><tbody>
    <% assignments.forEach(function(a){ %><tr><td><%= a.year %></td><td><a href="<%= url('/classes/' + a.class_id) %>"><%= a.code %> <%= a.name_zh %></a></td><td><%= one(a.role_en, a.role_zh) %></td><td><%= fmtDate(a.start_date) %></td><td><%= fmtDate(a.end_date) %></td>
      <td><% if (canAssign) { %><form method="post" action="<%= url('/people/' + person.id + '/assign/' + a.id + '/delete') %>" class="inline" data-confirm="<%= b('Remove this assignment?', '移除此指派？') %>"><%- csrfField() %><button class="linklike danger" type="submit"><%= b('Remove', '移除') %></button></form><% } %></td></tr><% }) %></tbody></table><% } else { %><p class="muted">—</p><% } %>
  <% if (canAssign) { %><p><a class="btn btn-ghost" href="<%= url('/people/' + person.id + '/assign') %>"><%= b('Add Instructor Assignment', '新增任課指派') %></a></p><% } %></div>
