<%# Portal header: hamburger (left menu) · brand · language · profile menu. locals: nav, U, current, altLangUrl, altLangLabel, b, one, url, lang, asset, csrfField %>
<%
  const here = current ? '/' + lang + current.replace(/^\/[a-z]{2}/, '') : '';
  const isHere = function(href){ return href.split('?')[0] === here; };
  const initials = ((U.person.english_first_name || '?')[0] + (U.person.english_last_name || '')[0]).toUpperCase();
  const roles = U.access.roles.map(function(r){ return one(r.name_en, r.name_zh); }).join(' · ');
%>
<header class="ph" data-portal-header>
  <div class="ph-bar">
    <button type="button" class="ph-icon ph-burger" data-ph-open="drawer" aria-controls="ph-drawer" aria-expanded="false" aria-label="<%= b('Open menu', '開啟選單') %>">
      <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
    </button>
    <a class="ph-brand" href="<%= url('') %>" aria-label="<%= b('Portal home', '入口首頁') %>">
      <img class="ph-logo-full" src="<%= asset('/brand/logo-3-full.svg') %>" alt="San Diego Chinese Academy 聖地牙哥中華學苑" width="257" height="50">
      <img class="ph-logo-badge" src="<%= asset('/brand/logo-1-badge.svg') %>" alt="San Diego Chinese Academy 聖地牙哥中華學苑" width="42" height="50">
    </a>
    <div class="ph-right">
      <a class="ph-lang" href="<%= altLangUrl %>" lang="<%= pickLang(lang, 'zh-Hant', 'en') %>"><%= altLangLabel %></a>
      <div class="ph-profile">
        <button type="button" class="ph-icon ph-avatar" data-ph-open="profile" aria-controls="ph-profile-menu" aria-expanded="false" aria-haspopup="true" aria-label="<%= b('Account menu', '帳號選單') %>">
          <svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.6-6 8-6s8 2 8 6z"/></svg>
        </button>
        <div class="ph-menu" id="ph-profile-menu" data-ph-panel="profile" data-open="false">
          <div class="ph-menu-head"><span class="ph-badge" aria-hidden="true"><%= initials %></span>
            <div><strong><%= U.person.english_first_name %> <%= U.person.english_last_name %> <%= U.person.chinese_name %></strong><small><%= roles %></small></div></div>
          <ul>
            <% nav.profileMenu.forEach(function(i){ %><li><a href="<%= i.href %>"<%- isHere(i.href) ? ' aria-current="page"' : '' %>><%= b(i.en, i.zh) %></a></li><% }) %>
          </ul>
          <form method="post" action="<%= url('/signout') %>" class="ph-logout"><%- csrfField() %><button type="submit"><%= b('Log Out', '登出') %></button></form>
        </div>
      </div>
    </div>
  </div>
  <div class="ph-overlay" data-ph-close data-open="false"></div>
  <aside class="ph-drawer" id="ph-drawer" data-ph-panel="drawer" data-open="false" aria-label="<%= b('Portal menu', '入口選單') %>">
    <div class="ph-drawer-head"><strong><%= b('Menu', '選單') %></strong>
      <button type="button" class="ph-icon" data-ph-close aria-label="<%= b('Close menu', '關閉選單') %>"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg></button></div>
    <nav class="ph-nav">
      <ul class="ph-list">
        <% nav.drawer.forEach(function(e){ %>
          <% if (e.link) { const i = e.link; %><li><a class="ph-item<%= isHere(i.href) ? ' is-here' : '' %>" href="<%= i.href %>"<%- i.blank ? ' target="_blank" rel="noopener"' : '' %>><%= b(i.en, i.zh) %></a></li>
          <% } else { const g = e.group; const open = g.items.some(function(i){ return isHere(i.href); }); %>
          <li><details class="portal-group ph-group"<%= open ? ' open' : '' %>>
            <summary><%= b(g.title.en, g.title.zh) %></summary>
            <ul><% g.items.forEach(function(i){ %><li><a href="<%= i.href %>"<%- isHere(i.href) ? ' aria-current="page"' : '' %><%- i.blank ? ' target="_blank" rel="noopener"' : '' %>><%= b(i.en, i.zh) %></a></li><% }) %></ul>
          </details></li>
          <% } %>
        <% }) %>
      </ul>
    </nav>
  </aside>
</header>
