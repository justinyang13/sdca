<h1><%= b('Class Placement', '分班') %> <small>· <%= year.label %></small></h1>
<p class="btn-row"><a class="btn <%= filter === 'unplaced' ? 'btn-primary' : 'btn-ghost' %>" href="<%= url('/placement?show=unplaced') %>"><%= b('Not placed yet', '尚未分班') %></a>
  <a class="btn <%= filter === 'all' ? 'btn-primary' : 'btn-ghost' %>" href="<%= url('/placement?show=all') %>"><%= b('All students', '所有學生') %></a></p>
<form method="post" action="<%= url('/placement') %>" class="portal-card"><%- csrfField() %>
  <div class="table-wrap"><table class="portal-table compact"><thead><tr><th><%= b('Student', '學生') %></th><th><%= b('Birthday', '生日') %></th><th><%= b('Class Type', '班別') %></th><th><%= b('SDCA Grade', '年級') %></th><th><%= b('Status', '狀態') %></th><th><%= b('Class', '班級') %></th></tr></thead><tbody>
  <% if (!rows.length) { %><tr><td colspan="6" class="empty"><%= b('Everyone is placed.', '所有學生都已分班。') %></td></tr><% } %>
  <% rows.forEach(function(r){ %><tr><td><a href="<%= url('/people/' + r.id) %>"><%= r.english_first_name %> <%= r.english_last_name %> <%= r.chinese_name %></a></td><td><%= fmtDate(r.birth_date) %></td><td><%= one(r.ct_en || '', r.ct_zh || '') %></td><td><%= gl(r.grade_label) %></td><td><span class="pill"><%= r.status %></span></td>
    <td><select name="class_<%= r.id %>"><option value=""></option>
      <% classes.filter(function(c){ return !r.class_type_id || c.class_type_id === r.class_type_id; }).forEach(function(c){ %><option value="<%= c.id %>" <%= r.school_class_id === c.id ? 'selected' : '' %>><%= c.code %> <%= one(c.name_en, c.name_zh) %> (<%= c.n %><%= c.capacity ? '/' + c.capacity : '' %>)</option><% }) %></select></td></tr><% }) %>
  </tbody></table></div>
  <div class="fact"><button class="btn btn-primary" type="submit"><%= b('Save placement', '儲存分班') %></button></div>
</form>
<p class="muted"><%= b('Parents see the class, room and teacher one week before the first day of school.', '家長在開學前一週可看到班級、教室與老師。') %></p>
