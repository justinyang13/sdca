<div class="portal-head">
  <h1><%= b('Event Calendar', '活動行事曆') %></h1>
  <div class="portal-actions">
    <a class="btn btn-ghost" href="<%= url('/manage/events') %>">☰ <%= b('List view', '清單檢視') %></a>
    <% if (canCreate) { %><a class="btn btn-primary" href="<%= url('/manage/events/new') %>">+ <%= b('New Event', '新增活動') %></a><% } %>
  </div>
</div>
<div class="cal-bar">
  <a class="btn btn-ghost" href="<%= url('/events-calendar') %>?month=<%= prev %>">‹</a>
  <h2><%= monthLabel %></h2>
  <a class="btn btn-ghost" href="<%= url('/events-calendar') %>?month=<%= next %>">›</a>
  <a class="btn btn-ghost" href="<%= url('/events-calendar') %>?month=<%= thisMonth %>"><%= b('Today', '今天') %></a>
  <span class="cal-legend"><% categories.forEach(function(c){ %><span class="ev ev-<%= c.v %>"><%= one(c.en, c.zh) %></span><% }) %></span>
</div>
<div class="pcal" role="grid">
  <% ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'].forEach(function(d, i){ %><div class="pcal-h" role="columnheader"><%= lang === 'zh' ? ['日','一','二','三','四','五','六'][i] : d %></div><% }) %>
  <% weeks.forEach(function(week){ week.forEach(function(c){ %>
  <div class="pcal-cell<%= c.inMonth ? '' : ' off' %><%= c.today ? ' today' : '' %>" role="gridcell">
    <% if (canCreate) { %><a class="pcal-day" href="<%= url('/manage/events/new') %>?starts_at=<%= c.key %>T00:00&all_day=1" title="<%= b('Add an event on this day', '在這天新增活動') %>"><%= c.day %></a><% } else { %><span class="pcal-day"><%= c.day %></span><% } %>
    <% c.events.slice(0, 4).forEach(function(e){ %><a class="ev ev-<%= e.category || 'other' %><%= e.published ? '' : ' draft' %>" href="<%= url('/manage/events/' + e.id) %>" title="<%= one(e.title_en, e.title_zh) %><%= e.location ? ' — ' + e.location : '' %>"><%= (!e.all_day && String(e.starts_at).length > 10) ? String(e.starts_at).slice(11, 16) + ' ' : '' %><%= one(e.title_en, e.title_zh) %></a><% }) %>
    <% if (c.events.length > 4) { %><span class="muted pcal-more">+<%= c.events.length - 4 %> <%= b('more', '更多') %></span><% } %>
  </div>
  <% }) }) %>
</div>
<p class="muted"><%= b('Events marked with a dashed border are not shown on the public website. Click a day to add an event, or an event to edit it.', '虛線框的活動不會顯示在公開網站。點選日期可新增活動，點選活動可編輯。') %></p>
