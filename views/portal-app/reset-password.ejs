<div class="portal-card portal-card-narrow">
  <h1><%= b('Reset Password', '重設密碼') %></h1>
  <% if (!valid) { %>
    <p class="portal-error"><%= b('This link has expired. Please request a new one.', '連結已失效，請重新申請。') %></p>
    <p><a class="btn btn-primary" href="<%= url('/forgot-password') %>"><%= b('Request Password Reset', '重建密碼') %></a></p>
  <% } else { %>
  <% if (error) { %><p class="portal-error" role="alert"><%= error %></p><% } %>
  <form method="post" action="<%= url('/reset-password/' + token) %>" class="pform">
    <%- csrfField() %>
    <%- field({ label: b('Home or cell phone on file', '住家或手機號碼'), name: 'phone', type: 'tel', required: true, attrs: 'required' }) %>
    <%- field({ label: b('New Password', '新密碼'), name: 'password', type: 'password', required: true, attrs: 'required minlength="8"' }) %>
    <%- field({ label: b('Re-type New Password', '再輸入新密碼'), name: 'password2', type: 'password', required: true, attrs: 'required' }) %>
    <div class="fact"><button class="btn btn-primary" type="submit"><%= b('Save New Password', '儲存新密碼') %></button></div>
  </form>
  <% } %>
</div>
