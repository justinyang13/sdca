<%
  const L = (en, zh) => b(en, zh);
  const st = [{v:'CA',label:'CA'},{v:'AZ',label:'AZ'},{v:'NV',label:'NV'},{v:'Other',label:'Other'}];
  const yn = [{v:'Y',label:'Y'},{v:'N',label:'N'}];
  const gd = [{v:'M',label:'M 男'},{v:'F',label:'F 女'}];
  const lg = ['Mandarin','English','Cantonese','Japanese','Korean','Vietnamese','Russian','Swedish','Other'].map(function(x){ return {v:x,label:x}; });
  const e = errors || {};
%>
<div class="portal-card">
  <h1><%= b('Create User For New Family ONLY', '新家長申請新帳戶') %></h1>
  <div class="portal-note-box">
    <p><strong><%= b('Important notes for returning families or families with current students in SDCA', '舊生/在校生家長請注意') %>:</strong>
      <a href="<%= url('/signin') %>"><%= b('Please sign in here.', '請由此連結登入.') %></a>
      <%= b('Do not use this form to create another new account! So we can keep tracking your payment history and student class assignment.', '不要再開新帳戶！我們才有您的付款紀錄與學生的在學資料。') %></p>
    <p><strong><%= b('For new families', '新學生家長') %>:</strong> <%= b('Welcome! Please fill out the form below to create a new account. Information collected below is for family address and the parents who would be managing the account, not the prospective students. Once the account is established, student information can be entered when signed in.', '歡迎您！請填寫此表格申請新帳戶。先填寫家長資料，等成功登入之後再加入學生資料。') %></p>
  </div>
  <form method="post" action="<%= url('/register') %>" class="pform pform-wide">
    <%- csrfField() %>
    <fieldset><legend><%= b('Family Address', '住址') %></legend>
      <%- field({ label: L('Street','路名'), name: 'street', value: v.street, error: e.street, required: true }) %>
      <%- field({ label: L('City','城市名'), name: 'city', value: v.city, error: e.city, required: true }) %>
      <%- field({ label: L('State','州名'), name: 'state', value: v.state, options: st }) %>
      <%- field({ label: L('Zipcode','郵遞區號'), name: 'zipcode', value: v.zipcode, error: e.zipcode, required: true, attrs: 'size="6"' }) %>
      <%- field({ label: L('Home Phone','住家電話'), name: 'home_phone', type: 'tel', value: v.home_phone, error: e.home_phone, required: true }) %>
      <%- field({ label: L('Cell Phone','手機號碼'), name: 'cell_phone', type: 'tel', value: v.cell_phone }) %>
      <%- field({ label: L('Email','電子郵件信箱'), name: 'email', type: 'email', value: v.email, error: e.email, required: true }) %>
      <%- field({ label: L('List In School Directory','列在學校通訊錄'), name: 'list_in_directory', value: v.list_in_directory, options: yn }) %>
    </fieldset>
    <fieldset><legend><%= b('Emergency Contact', '緊急聯絡') %></legend>
      <%- field({ label: L('Contact','緊急聯絡人'), name: 'emergency_contact', value: v.emergency_contact, error: e.emergency_contact, required: true }) %>
      <%- field({ label: L('Home Phone','緊急聯絡電話'), name: 'emergency_home_phone', type: 'tel', value: v.emergency_home_phone, error: e.emergency_home_phone, required: true }) %>
      <%- field({ label: L('Cell Phone','緊急聯絡手機'), name: 'emergency_cell_phone', type: 'tel', value: v.emergency_cell_phone, error: e.emergency_cell_phone, required: true }) %>
    </fieldset>
    <fieldset><legend><%= b('Parent One', '家長一') %></legend>
      <%- field({ label: L('Last Name','姓'), name: 'p1_last', value: v.p1_last, error: e.p1_last, required: true }) %>
      <%- field({ label: L('First Name','名'), name: 'p1_first', value: v.p1_first, error: e.p1_first, required: true }) %>
      <%- field({ label: L('Chinese Name','中文姓名'), name: 'p1_chinese', value: v.p1_chinese }) %>
      <%- field({ label: L('Gender','性別'), name: 'gender', value: v.gender, options: gd }) %>
      <%- field({ label: L('Native Language','母語'), name: 'native_language', value: v.native_language, options: lg }) %>
    </fieldset>
    <fieldset><legend><%= b('Parent Two (optional)', '家長二 (選填)') %></legend>
      <%- field({ label: L('Last Name','姓'), name: 'p2_last', value: v.p2_last }) %>
      <%- field({ label: L('First Name','名'), name: 'p2_first', value: v.p2_first }) %>
      <%- field({ label: L('Chinese Name','中文姓名'), name: 'p2_chinese', value: v.p2_chinese }) %>
      <%- field({ label: L('Gender','性別'), name: 'gender2', value: v.gender2, options: gd }) %>
      <%- field({ label: L('Native Language','母語'), name: 'native_language2', value: v.native_language2, options: lg }) %>
    </fieldset>
    <fieldset><legend><%= b('Please create your account username and password', '請輸入用戶名稱與密碼') %></legend>
      <%- field({ label: L('Username','用戶名稱'), name: 'username', value: v.username, error: e.username, required: true, attrs: 'autocomplete="username" minlength="4"' }) %>
      <%- field({ label: L('Password','密碼'), name: 'password', type: 'password', error: e.password, required: true, help: b('At least 8 characters, case sensitive', '至少八個字，大小寫字母不同'), attrs: 'minlength="8"' }) %>
      <%- field({ label: L('Re-type Password','再輸入密碼'), name: 'password2', type: 'password', error: e.password2, required: true }) %>
    </fieldset>
    <p class="req-note"><span class="req">*</span> <%= b('Required Field', '必須填寫') %></p>
    <div class="fact"><button class="btn btn-primary" type="submit"><%= b('Create User', '建立用戶') %></button></div>
  </form>
</div>
