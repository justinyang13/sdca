<div class="portal-head"><h1><%= b('Manage Enrollment', '管理註冊') %></h1></div>
<% fams.forEach(function(F){ const fid = F.fam.id; %>
<div class="portal-card">
  <h2><%= b('Registration', '註冊') %></h2>
  <% if (canRegister && F.children.length) { %><p class="btn-row"><% F.regOptions.forEach(function(o){ %><a class="btn btn-primary" href="<%= url('/families/' + fid + '/register?year=' + o.year.id) %>"><%= o.reregister ? b('Re-register For ' + o.year.label + ' School Year', '續讀註冊 ' + o.year.label + ' 學年') : b('Register For ' + o.year.label + ' School Year', '註冊 ' + o.year.label + ' 學年') %></a> <% }) %>
    <a class="btn btn-ghost" href="<%= url('/families/' + fid + '/add-child') %>"><%= b('Add Child', '加入學生') %></a> <a class="btn btn-ghost" href="<%= url('/volunteer?family=' + fid) %>"><%= b('Volunteer Sign Up', '義工報名') %></a></p><% } %>
  <% if (!F.regOptions.length) { %><p class="muted"><%= b('Registration is not open right now, or every child is already registered.', '目前未開放註冊，或所有學生皆已註冊。') %></p><% } %>
  <% if (F.registrations.length) { %><table class="portal-table compact"><thead><tr><th>#</th><th><%= b('Status', '狀態') %></th><th class="num"><%= b('Total', '總額') %></th><th></th></tr></thead><tbody>
    <% F.registrations.forEach(function(r){ %><tr><td>#<%= r.id %></td><td><span class="pill"><%= r.status %></span></td><td class="num"><%= money(r.grand_total_cents) %></td>
      <td><% if (r.status === 'draft') { %><a href="<%= url('/registrations/' + r.id + '/waiver') %>"><%= b('Continue registration', '繼續註冊') %></a><% } else { %><a href="<%= url('/registrations/' + r.id + '/form') %>"><%= b('View form', '檢視註冊表') %></a><% } %></td></tr><% }) %></tbody></table><% } %>
</div>
<div class="portal-card"><h2><%= b('Students and classes', '學生與班級') %></h2>
  <% if (!F.children.length) { %><p class="muted">—</p><% } else { %><table class="portal-table compact"><thead><tr><th><%= b('Student', '學生') %></th><th><%= F.year ? F.year.label : '' %> <%= b('Grade', '年級') %></th><th><%= b('Class', '班級') %></th><th><%= b('Teacher', '老師') %></th><th></th></tr></thead><tbody>
    <% F.children.forEach(function(c){ const e = c.enrollment; %><tr><td><%= c.english_first_name %> <%= c.english_last_name %> <%= c.chinese_name %></td><td><%= e ? gl(e.grade_label) : '—' %></td>
      <td><%= e && c.showPlacement && e.class_code ? one(e.name_en, e.name_zh) : '—' %></td><td><%= e && c.showPlacement && e.teacher ? e.teacher : '—' %></td>
      <td><a href="<%= url('/people/' + c.id + '/edit') %>"><%= b('Edit student', '編輯學生') %></a></td></tr><% }) %></tbody></table><% } %>
</div>
<% }) %>
