<%
  // hero-carousel.ejs — home hero sliding bulletin board. Every slide is a database record (Staff Tools → Hero Slides):
  // title, description, image and a link ("find out more", optional second button). Three layouts:
  //   photo   — picture with a caption bar: title, description, one button
  //   feature — centred headline, description and up to two buttons (e.g. Enroll)
  //   intro   — welcome text in two columns (中文 | English) with decorative side banners
  // Server renders all slides; JS (public/js/hero-carousel.js) adds auto-advance, prev/next, dots, keyboard, swipe, pause
  // and respects prefers-reduced-motion. Without JS: first slide visible.
  // L.slides: rows of `slides` with html_en / html_zh (the markdown descriptions rendered and sanitised by the route).
  const slides = (typeof L !== 'undefined' && L.slides) ? L.slides : [];
  const manifest = (typeof imageManifest === 'function') ? imageManifest() : {};
  const schoolName = (L && (L.schoolName)) || (lang === 'zh' ? '聖地牙哥中華學苑' : 'San Diego Chinese Academy');
  const escapeAttr = (v) => String(v == null ? '' : v).replace(/&/g,'&amp;').replace(/"/g,'&quot;').replace(/</g,'&lt;');
  // an image is a name from the image library (responsive sizes) or a plain path such as /img/slides/x.jpg
  const imgFor = (name) => {
    if (!name) return null;
    const entry = manifest[name];
    if (entry && entry.files && entry.files.length) {
      const best = entry.files[entry.files.length - 1];
      const srcset = entry.files.map((f) => (f.file.startsWith('/') ? f.file : '/' + f.file) + ' ' + f.w + 'w').join(', ');
      return { src: (best.file.startsWith('/') ? best.file : '/' + best.file), srcset, w: best.w, h: best.h, alt_en: entry.alt_en, alt_zh: entry.alt_zh };
    }
    return /^\//.test(name) ? { src: name, srcset: '', w: null, h: null } : null;
  };
  const href = (u) => (!u ? '' : !/^(\/(?!\/)|https?:\/\/|mailto:|tel:)/i.test(u) ? '#' : (/^\/(en|zh)(\/|$)/.test(u) || !/^\//.test(u)) ? u : '/' + lang + u);
  const pickT = (s) => (lang === 'zh' ? (s.caption_zh || s.caption_en || '') : (s.caption_en || s.caption_zh || ''));
  const pickD = (s) => (lang === 'zh' ? (s.html_zh || s.html_en || '') : (s.html_en || s.html_zh || ''));
  const label = (s, n, fallbackEn, fallbackZh) => (n === 2
    ? (lang === 'zh' ? (s.link2_label_zh || s.link2_label_en) : (s.link2_label_en || s.link2_label_zh))
    : (lang === 'zh' ? (s.link_label_zh || s.link_label_en) : (s.link_label_en || s.link_label_zh))) || (lang === 'zh' ? fallbackZh : fallbackEn);
%>
<section class="hero-carousel" role="region" aria-roledescription="carousel" aria-label="<%= lang === 'zh' ? '歡迎橫幅' : 'Welcome banner' %>" data-carousel>
  <div class="hero-carousel-slides" data-carousel-slides>
    <% slides.forEach(function(slide, i) {
      const img = imgFor(slide.image);
      const title = pickT(slide);
      const alt = title || (img && (lang === 'zh' ? img.alt_zh : img.alt_en)) || '';
      const desc = pickD(slide);
    %>
    <% if (slide.layout === 'intro') { const left = imgFor(slide.image_left); const right = imgFor(slide.image_right); %>
    <article class="hero-carousel-slide is-intro" role="group" aria-roledescription="slide" aria-label="<%= escapeAttr(alt) %>">
      <% if (img) { %><div class="hero-carousel-media" aria-hidden="true"><img class="hero-carousel-img" src="<%= img.src %>"<% if (img.srcset) { %> srcset="<%= img.srcset %>" sizes="100vw"<% } %><% if (img.w) { %> width="<%= img.w %>" height="<%= img.h %>"<% } %> alt="" <%= i === 0 ? 'fetchpriority="high"' : 'loading="lazy"' %>></div><% } %>
      <h1 class="sr-only"><%= i === 0 ? schoolName : alt %></h1>
      <div class="hero-intro blocks-in-hero" data-page="home">
        <div class="blk-columns blk-cols-4">
          <div class="blk-col"><% if (left) { %><div class="blk-vis hide-phone"><figure class="blk-image"><img src="<%= left.src %>" alt="" loading="lazy" decoding="async"></figure></div><% } %></div>
          <div class="blk-col"><div class="blk-richtext"><%- slide.html_zh %></div></div>
          <div class="blk-col"><div class="blk-richtext"><%- slide.html_en %>
            <% if (slide.link_url) { %><p><a class="btn btn-ghost btn-sm" href="<%= href(slide.link_url) %>"><%= label(slide, 1, 'Learn more', '了解更多') %> →</a></p><% } %></div></div>
          <div class="blk-col"><% if (right) { %><div class="blk-vis hide-phone"><figure class="blk-image"><img src="<%= right.src %>" alt="" loading="lazy" decoding="async"></figure></div><% } %></div>
        </div>
      </div>
    </article>
    <% return; } %>
    <article class="hero-carousel-slide" role="group" aria-roledescription="slide" aria-label="<%= escapeAttr(alt) %>">
      <div class="hero-carousel-media" aria-hidden="true">
        <% if (img) { %>
          <img class="hero-carousel-img" src="<%= img.src %>"<% if (img.srcset) { %> srcset="<%= img.srcset %>" sizes="(max-width: 768px) 100vw, 1600px"<% } %><% if (img.w) { %> width="<%= img.w %>" height="<%= img.h %>"<% } %>
               alt="<%= escapeAttr(alt) %>" <%= i === 0 ? 'fetchpriority="high"' : 'loading="lazy"' %>>
        <% } else { %>
          <div class="hero-carousel-img hero-carousel-fallback"></div>
        <% } %>
      </div>
      <div class="hero-carousel-inner">
        <% if (slide.layout === 'feature') { %>
        <div class="hero-enroll">
          <% if (title) { %><h2 class="hero-feature-title"><%= title %></h2><% } %>
          <% if (desc) { %><div class="hero-carousel-tagline"><%- desc %></div><% } %>
          <% if (slide.link_url || slide.link2_url) { %><div class="hero-carousel-cta">
            <% if (slide.link_url) { %><a class="btn btn-primary btn-lg" href="<%= href(slide.link_url) %>"><%= label(slide, 1, 'Learn more', '了解更多') %></a><% } %>
            <% if (slide.link2_url) { %><a class="btn btn-light btn-lg" href="<%= href(slide.link2_url) %>"><%= label(slide, 2, 'Learn more', '了解更多') %></a><% } %>
          </div><% } %>
        </div>
        <% } else if (title || desc || slide.link_url) { %>
        <div class="hero-carousel-caption">
          <% if (title) { %><span class="hero-carousel-caption-text"><%= title %></span><% } %>
          <% if (desc) { %><div class="hero-caption-desc"><%- desc %></div><% } %>
          <% if (slide.link_url) { %><a class="btn btn-light btn-sm" href="<%= href(slide.link_url) %>"><%= label(slide, 1, 'Learn more', '了解更多') %> →</a><% } %>
        </div>
        <% } %>
      </div>
    </article>
    <% }) %>
  </div>
  <div class="hero-carousel-controls" aria-hidden="true">
    <button type="button" class="hero-carousel-btn hero-carousel-prev" data-carousel-prev aria-label="<%= lang === 'zh' ? '上一張' : 'Previous slide' %>">
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M15 6l-6 6 6 6"/></svg>
    </button>
    <button type="button" class="hero-carousel-btn hero-carousel-next" data-carousel-next aria-label="<%= lang === 'zh' ? '下一張' : 'Next slide' %>">
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>
    </button>
  </div>
  <div class="hero-carousel-dots" role="tablist" aria-label="<%= lang === 'zh' ? '選擇橫幅' : 'Choose slide' %>">
    <% slides.forEach(function(slide, i) {
      const alt = pickT(slide);
    %>
    <button type="button" class="hero-carousel-dot <%= i === 0 ? 'is-active' : '' %>" role="tab" aria-selected="<%= String(i === 0) %>" aria-label="<%= escapeAttr(alt) %> — <%= lang === 'zh' ? '第' + (i + 1) + '張' : 'slide ' + (i + 1) %>" data-carousel-dot="<%= i %>"></button>
    <% }) %>
  </div>
</section>
