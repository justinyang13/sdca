<%
  // document-list.ejs — documents. Read from L: docs (array of {slug, title, href, mime, size, year, category})
  const list = (typeof L !== 'undefined' && L.docs) ? L.docs : [];
  const iconSvg = {
    pdf: '<path d="M3 1h8l4 4v10H3z"/><path d="M11 1v4h4"/><path d="M6 9h6M6 12h6M6 15h4"/>',
    doc: '<path d="M3 1h8l4 4v10H3z"/><path d="M11 1v4h4"/><path d="M6 9h6M6 12h6M6 15h4"/>',
    xls: '<path d="M3 1h8l4 4v10H3z"/><path d="M11 1v4h4"/><path d="M6 9l4 6M10 9l-4 6"/>',
    default: '<path d="M3 1h8l4 4v10H3z"/><path d="M11 1v4h4"/>'
  };
%>
<ul class="doc-list">
  <% list.forEach(function(d) { %>
    <li class="doc-item">
      <span class="doc-icon" aria-hidden="true">
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4">
          <%= iconSvg[d.mime] || iconSvg.default %>
        </svg>
      </span>
      <div>
        <h3 class="doc-title" style="font-family:var(--font-sans); font-size:1rem">
          <a href="<%= d.href %>" <%= /\.pdf$/i.test(d.href) ? 'target="_blank" rel="noopener"' : '' %><%= d.title %></a>
        </h3>
        <div class="doc-meta">
          <% if (d.category) { %><%= d.category %> · <% } %>
          <% if (d.year) { %><%= d.year %> · <% } %>
          <%= d.size || 'PDF' %>
        </div>
      </div>
      <div class="doc-cta">
        <a class="btn btn-ghost btn-sm" href="<%= /\.pdf$/i.test(d.href) ? d.href + '/download' : d.href %>" <%= /\.pdf$/i.test(d.href) ? 'download' : '' %> rel="noopener">
          <svg width="14" height="14" viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M8 2v8M4 7l4 4 4-4M2 14h12"/></svg>
          <%= t('button.download') %>
        </a>
      </div>
    </li>
  <% }) %>
</ul>
